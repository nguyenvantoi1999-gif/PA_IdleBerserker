            = vs_TEXCOORD0.xy * _MainTex_ST.xy + _MainTex_ST.zw;\n    u_xlat1.xy
            = _SpeedMainTexUVNoiseZW.xy * _Time.yy + u_xlat1.xy;\n    u_xlat16_1.xyz
            = texture(_MainTex, u_xlat1.xy).xyz;\n    u_xlat2.xyz = u_xlat16_1.xyz
            * _FresnelColor.xyz;\n    u_xlat2.xyz = u_xlat2.xyz * vec3(_SeparateEmission)
            + u_xlat0.xyz;\n    u_xlat0.xyz = u_xlat0.xyz * vec3(_Emission);\n   
            u_xlat0.xyz = u_xlat0.xyz * vs_COLOR0.xyz;\n    u_xlat0.xyz = u_xlat0.xyz
