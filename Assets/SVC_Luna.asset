          VertexProgram: "\n#version 300 es\n\n#define HLSLCC_ENABLE_UNIFORM_BUFFERS
            0\n#if HLSLCC_ENABLE_UNIFORM_BUFFERS\n#define UNITY_UNIFORM\n#else\n#define
            UNITY_UNIFORM uniform\n#endif\n#define UNITY_SUPPORTS_UNIFORM_LOCATION
            0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define UNITY_LOCATION(x) layout(location
            = x)\n#define UNITY_BINDING(x) layout(binding = x, std140)\n#else\n#define
            UNITY_LOCATION(x)\n#define UNITY_BINDING(x) layout(std140)\n#endif\nuniform
            \tvec4 hlslcc_mtx4x4unity_ObjectToWorld[4];\nuniform \tvec4 hlslcc_mtx4x4unity_MatrixVP[4];\nuniform
            \tvec4 _MainTex_ST;\nuniform \tvec4 _SecondTex_ST;\nuniform \tvec4 _ThirdTex_ST;\nin
            highp vec4 in_POSITION0;\nin highp vec2 in_TEXCOORD0;\nin highp vec2
            in_TEXCOORD1;\nin highp vec2 in_TEXCOORD2;\nout highp vec2 vs_TEXCOORD0;\nout
            highp vec2 vs_TEXCOORD1;\nout highp vec2 vs_TEXCOORD2;\nvec4 u_xlat0;\nvec4
            u_xlat1;\nvoid main()\n{\n    vs_TEXCOORD0.xy = in_TEXCOORD0.xy * _MainTex_ST.xy
            + _MainTex_ST.zw;\n    vs_TEXCOORD1.xy = in_TEXCOORD1.xy * _SecondTex_ST.xy
            + _SecondTex_ST.zw;\n    vs_TEXCOORD2.xy = in_TEXCOORD2.xy * _ThirdTex_ST.xy
            + _ThirdTex_ST.zw;\n    u_xlat0 = in_POSITION0.yyyy * hlslcc_mtx4x4unity_ObjectToWorld[1];\n   
            u_xlat0 = hlslcc_mtx4x4unity_ObjectToWorld[0] * in_POSITION0.xxxx + u_xlat0;\n   
            u_xlat0 = hlslcc_mtx4x4unity_ObjectToWorld[2] * in_POSITION0.zzzz + u_xlat0;\n   
            u_xlat0 = u_xlat0 + hlslcc_mtx4x4unity_ObjectToWorld[3];\n    u_xlat1
            = u_xlat0.yyyy * hlslcc_mtx4x4unity_MatrixVP[1];\n    u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[0]
            * u_xlat0.xxxx + u_xlat1;\n    u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[2]
            * u_xlat0.zzzz + u_xlat1;\n    gl_Position = hlslcc_mtx4x4unity_MatrixVP[3]
            * u_xlat0.wwww + u_xlat1;\n    return;\n}\n\n"
          FragmentProgram: "\n#version 300 es\n\nprecision highp float;\nprecision
            highp int;\n#define HLSLCC_ENABLE_UNIFORM_BUFFERS 0\n#if HLSLCC_ENABLE_UNIFORM_BUFFERS\n#define
            UNITY_UNIFORM\n#else\n#define UNITY_UNIFORM uniform\n#endif\n#define
            UNITY_SUPPORTS_UNIFORM_LOCATION 0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define
            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tvec4 _MainTex_ST;\nuniform
            \tvec2 _Speed1;\nuniform \tvec4 _SecondTex_ST;\nuniform \tvec2 _Speed2;\nuniform
            \tvec4 _ThirdTex_ST;\nuniform \tvec2 _Speed3;\nuniform \tvec4 _AlphaColor;\nuniform
            \tvec4 _HotLineColor;\nuniform \tvec4 _MainColor;\nuniform \tfloat _FillLevel;\nuniform
            \tfloat _FadeAreaHeight;\nuniform \tfloat _HotLineHeight;\nuniform \tfloat
            _Brightness;\nuniform \tfloat _HotLineBrightness;\nUNITY_LOCATION(0)
            uniform mediump sampler2D _MainTex;\nUNITY_LOCATION(1) uniform mediump
            sampler2D _SecondTex;\nUNITY_LOCATION(2) uniform mediump sampler2D _ThirdTex;\nin
            highp  vec2 vs_TEXCOORD0;\nin highp  vec2 vs_TEXCOORD1;\nin highp  vec2
            vs_TEXCOORD2;\nlayout(location = 0) out mediump vec4 SV_Target0;\nvec4
            u_xlat0;\nmediump vec4 u_xlat16_0;\nvec4 u_xlat1;\nmediump vec4 u_xlat16_1;\nvec3
            u_xlat2;\nmediump vec4 u_xlat16_2;\nvec4 u_xlat3;\nbool u_xlatb3;\nmediump
            vec4 u_xlat16_4;\nmediump vec3 u_xlat16_5;\nvec3 u_xlat8;\nvec2 u_xlat9;\nfloat
            u_xlat12;\nfloat u_xlat13;\nvec2 u_xlat14;\nfloat u_xlat18;\nbool u_xlatb18;\nfloat
            u_xlat19;\nbool u_xlatb19;\nfloat u_xlat20;\nvoid main()\n{\n    u_xlat0.xy
            = vs_TEXCOORD2.xy + (-_ThirdTex_ST.zw);\n    u_xlat0.xy = u_xlat0.xy
            + u_xlat0.xy;\n    u_xlat0.xy = u_xlat0.xy / _ThirdTex_ST.xy;\n    u_xlat0.xy
            = u_xlat0.xy + vec2(-1.0, -1.0);\n    u_xlat12 = dot(u_xlat0.xy, u_xlat0.xy);\n   
            u_xlat0.xy = u_xlat0.xy * _ThirdTex_ST.xy;\n    u_xlat18 = (-u_xlat12)
            + 1.0;\n    u_xlat1.x = inversesqrt(u_xlat18);\n    u_xlatb18 = u_xlat18>=0.0;\n   
            u_xlat18 = u_xlatb18 ? 1.0 : float(0.0);\n    u_xlat1.x = float(1.0)
            / u_xlat1.x;\n    u_xlat1.x = (-u_xlat1.x) + 1.0;\n    u_xlat12 = u_xlat1.x
            / u_xlat12;\n    u_xlat0.xy = u_xlat0.xy * vec2(u_xlat12) + _ThirdTex_ST.zw;\n   
            u_xlat1.xy = _Time.xx * _Speed3.xy;\n    u_xlat0.xy = u_xlat0.xy * vec2(0.5,
            0.5) + u_xlat1.xy;\n    u_xlat0.xy = u_xlat0.xy + vec2(-0.5, -0.5);\n   
            u_xlat16_1.xyz = texture(_ThirdTex, u_xlat0.xy).xyz;\n    u_xlat16_1.w
            = 1.0;\n    u_xlat0 = vec4(u_xlat18) * u_xlat16_1;\n    u_xlat1.xy =
            vs_TEXCOORD1.xy + (-_SecondTex_ST.zw);\n    u_xlat1.xy = u_xlat1.xy +
            u_xlat1.xy;\n    u_xlat1.xy = u_xlat1.xy / _SecondTex_ST.xy;\n    u_xlat1.xy
            = u_xlat1.xy + vec2(-1.0, -1.0);\n    u_xlat13 = dot(u_xlat1.xy, u_xlat1.xy);\n   
            u_xlat1.xy = u_xlat1.xy * _SecondTex_ST.xy;\n    u_xlat19 = (-u_xlat13)
            + 1.0;\n    u_xlat2.x = inversesqrt(u_xlat19);\n    u_xlatb19 = u_xlat19>=0.0;\n   
            u_xlat19 = u_xlatb19 ? 1.0 : float(0.0);\n    u_xlat2.x = float(1.0)
            / u_xlat2.x;\n    u_xlat2.x = (-u_xlat2.x) + 1.0;\n    u_xlat13 = u_xlat2.x
            / u_xlat13;\n    u_xlat1.xy = u_xlat1.xy * vec2(u_xlat13) + _SecondTex_ST.zw;\n   
            u_xlat2.xy = _Time.xx * _Speed2.xy;\n    u_xlat1.xy = u_xlat1.xy * vec2(0.5,
            0.5) + u_xlat2.xy;\n    u_xlat1.xy = u_xlat1.xy + vec2(-0.5, -0.5);\n   
            u_xlat16_2.xyz = texture(_SecondTex, u_xlat1.xy).xyz;\n    u_xlat16_2.w
            = 1.0;\n    u_xlat1 = vec4(u_xlat19) * u_xlat16_2;\n    u_xlat2.xyz =
            vs_TEXCOORD0.yxy + (-_MainTex_ST.wzw);\n    u_xlat8.xy = u_xlat2.yz +
            u_xlat2.yz;\n    u_xlat8.xy = u_xlat8.xy / _MainTex_ST.xy;\n    u_xlat8.xy
            = u_xlat8.xy + vec2(-1.0, -1.0);\n    u_xlat20 = dot(u_xlat8.xy, u_xlat8.xy);\n   
            u_xlat8.xy = u_xlat8.xy * _MainTex_ST.xy;\n    u_xlat3.x = (-u_xlat20)
            + 1.0;\n    u_xlat9.x = inversesqrt(u_xlat3.x);\n    u_xlatb3 = u_xlat3.x>=0.0;\n   
            u_xlat3.x = u_xlatb3 ? 1.0 : float(0.0);\n    u_xlat9.x = float(1.0)
            / u_xlat9.x;\n    u_xlat9.x = (-u_xlat9.x) + 1.0;\n    u_xlat20 = u_xlat9.x
            / u_xlat20;\n    u_xlat8.xy = u_xlat8.xy * vec2(u_xlat20) + _MainTex_ST.zw;\n   
            u_xlat9.xy = _Time.xx * _Speed1.xy;\n    u_xlat8.xy = u_xlat8.xy * vec2(0.5,
            0.5) + u_xlat9.xy;\n    u_xlat8.xy = u_xlat8.xy + vec2(-0.5, -0.5);\n   
            u_xlat16_4.xyz = texture(_MainTex, u_xlat8.xy).xyz;\n    u_xlat16_4.w
            = 1.0;\n    u_xlat3 = u_xlat3.xxxx * u_xlat16_4;\n    u_xlat16_1 = u_xlat1
            * u_xlat3;\n    u_xlat16_0 = u_xlat0 * u_xlat16_1;\n    u_xlat8.x = _FadeAreaHeight
            + 1.0;\n    u_xlat8.x = _FillLevel * u_xlat8.x + (-_FadeAreaHeight);\n   
            u_xlat14.x = u_xlat8.x * _MainTex_ST.y + _HotLineHeight;\n    u_xlat2.x
            = (-u_xlat8.x) * _MainTex_ST.y + u_xlat2.x;\n    u_xlat8.x = u_xlat14.x
            + (-vs_TEXCOORD0.y);\n    u_xlat8.x = u_xlat8.x + _MainTex_ST.w;\n   
            u_xlat14.xy = vec2(1.0, 1.0) / vec2(_FadeAreaHeight, _HotLineHeight);\n   
            u_xlat8.x = u_xlat14.y * abs(u_xlat8.x);\n    u_xlat8.x = clamp(u_xlat8.x,
            0.0, 1.0);\n    u_xlat2.x = u_xlat14.x * u_xlat2.x;\n    u_xlat2.x =
            clamp(u_xlat2.x, 0.0, 1.0);\n    u_xlat14.x = u_xlat8.x * -2.0 + 3.0;\n   
            u_xlat8.x = u_xlat8.x * u_xlat8.x;\n    u_xlat8.x = (-u_xlat14.x) * u_xlat8.x
            + 1.0;\n    u_xlat8.xyz = u_xlat8.xxx * _HotLineColor.xyz;\n    u_xlat8.xyz
            = u_xlat8.xyz * _HotLineColor.www;\n    u_xlat8.xyz = u_xlat8.xyz * vec3(_HotLineBrightness);\n   
            u_xlat3.x = u_xlat2.x * -2.0 + 3.0;\n    u_xlat2.x = u_xlat2.x * u_xlat2.x;\n   
            u_xlat2.x = u_xlat2.x * u_xlat3.x;\n    u_xlat1 = _AlphaColor + (-_MainColor);\n   
            u_xlat1 = u_xlat2.xxxx * u_xlat1 + _MainColor;\n    u_xlat16_5.x = u_xlat1.y
            + u_xlat1.x;\n    u_xlat16_5.x = u_xlat1.z + u_xlat16_5.x;\n    u_xlat16_5.x
            = u_xlat16_5.x * 0.333333343;\n    u_xlat2.xyz = u_xlat16_5.xxx * u_xlat8.xyz
            + u_xlat1.xyz;\n    u_xlat1.w = u_xlat16_0.w * u_xlat1.w;\n    u_xlat16_5.xyz
            = u_xlat16_0.xyz * u_xlat2.xyz;\n    u_xlat1.xyz = u_xlat16_5.xyz * vec3(vec3(_Brightness,
            _Brightness, _Brightness));\n    SV_Target0 = u_xlat1;\n    return;\n}\n\n"
