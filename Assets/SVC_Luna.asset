            + u_xlat0.xy;\n    u_xlat0.xy = u_xlat0.xy + vs_TEXCOORD1.ww;\n    u_xlat16_0
            = texture(_Noise, u_xlat0.xy).x;\n    u_xlat3.xy = vs_TEXCOORD0.xy *
            _Mask_ST.xy + _Mask_ST.zw;\n    u_xlat16_3 = texture(_Mask, u_xlat3.xy).x;\n   
            u_xlat0.x = u_xlat16_0 * u_xlat16_3;\n    u_xlat3.x = vs_TEXCOORD1.z
            + -1.0;\n    u_xlat3.x = _UseCustomData * u_xlat3.x + 1.0;\n    u_xlat0.x
            = u_xlat0.x * u_xlat3.x + (-_Cutoff);\n    u_xlatb0 = u_xlat0.x<0.0;\n   
            if(u_xlatb0){discard;}\n    u_xlat0.xyz = (-vs_TEXCOORD3.xyz) + _WorldSpaceCameraPos.xyz;\n   
            u_xlat9 = dot(u_xlat0.xyz, u_xlat0.xyz);\n    u_xlat9 = inversesqrt(u_xlat9);\n   
            u_xlat0.xyz = vec3(u_xlat9) * u_xlat0.xyz;\n    u_xlat0.x = dot(vs_TEXCOORD2.xyz,
            u_xlat0.xyz);\n    u_xlati3 = int((0.0<u_xlat0.x) ? 0xFFFFFFFFu : uint(0));\n   
            u_xlati6 = int((u_xlat0.x<0.0) ? 0xFFFFFFFFu : uint(0));\n    u_xlat0.x
            = (-u_xlat0.x) + 1.0;\n    u_xlat0.x = log2(u_xlat0.x);\n    u_xlat0.x
            = u_xlat0.x * _Fresnel;\n    u_xlat0.x = exp2(u_xlat0.x);\n    u_xlati3
            = (-u_xlati3) + u_xlati6;\n    u_xlat3.x = float(u_xlati3);\n    u_xlat3.x
            = u_xlat3.x + 1.0;\n    u_xlat3.x = u_xlat3.x * -0.5 + 1.0;\n    u_xlat1.xyz
            = vec3(vec3(_FresnelEmission, _FresnelEmission, _FresnelEmission)) *
            _FresnelColor.xyz;\n    u_xlat1.xyz = u_xlat0.xxx * u_xlat1.xyz;\n   
