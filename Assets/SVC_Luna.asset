            highp  vec2 vs_TEXCOORD1;\nin mediump  vec4 vs_TEXCOORD3;\nlayout(location
            = 0) out mediump vec4 SV_Target0;\nmediump float u_xlat16_0;\nbool u_xlatb0;\nmediump
