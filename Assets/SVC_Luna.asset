            * _Color;\n    u_xlat0 = u_xlat0 * vs_COLOR0;\n    u_xlat1.x = (-vs_TEXCOORD0.z)
            + 1.0;\n    u_xlat1.xyz = (-u_xlat1.xxx) + u_xlat16_2.xyz;\n    u_xlat1.xyz
