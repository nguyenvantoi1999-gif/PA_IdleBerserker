            UNITY_SUPPORTS_UNIFORM_LOCATION 0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define
            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tmediump vec4
            _TintColor;\nuniform \tfloat _EmissiveMultiply;\nuniform \tfloat _TimeScale1;\nuniform
            \tvec4 _MainTiling;\nuniform \tfloat _MainTexturePower;\nuniform \tfloat
            _TimeScale2;\nuniform \tfloat _UseTextureMaskAlpha;\nuniform \tvec4 _TextureMaskAlpha_ST;\nuniform
            \tfloat _OpacityMultiply;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _MainTex;\nUNITY_LOCATION(1) uniform mediump sampler2D _TextureMaskAlpha;\nin
            mediump  vec4 vs_COLOR0;\nin highp  vec4 vs_TEXCOORD0;\nlayout(location
            = 0) out mediump vec4 SV_Target0;\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nvec4
            u_xlat1;\nmediump vec4 u_xlat16_1;\nbool u_xlatb3;\nvoid main()\n{\n   
            u_xlat0.x = _Time.y * _TimeScale1;\n    u_xlat1 = vs_TEXCOORD0.xyxy *
            _MainTiling;\n    u_xlat0.xy = u_xlat0.xx * vec2(-1.0, 0.0) + u_xlat1.xy;\n   
            u_xlat16_0 = texture(_MainTex, u_xlat0.xy);\n    u_xlat0 = log2(u_xlat16_0);\n   
            u_xlat0 = u_xlat0 * vec4(_MainTexturePower);\n    u_xlat0 = exp2(u_xlat0);\n   
            u_xlat1.x = _Time.y * _TimeScale2;\n    u_xlat1.xy = u_xlat1.xx * vec2(-1.0,
            0.0) + u_xlat1.zw;\n    u_xlat16_1 = texture(_MainTex, u_xlat1.xy);\n   
            u_xlat1 = log2(u_xlat16_1);\n    u_xlat1 = u_xlat1 * vec4(_MainTexturePower);\n   
            u_xlat1 = exp2(u_xlat1);\n    u_xlat0 = u_xlat0 + u_xlat1;\n    u_xlat0
            = u_xlat0 * vs_COLOR0;\n    u_xlat0 = u_xlat0 * _TintColor;\n    u_xlat1.xy
            = vs_TEXCOORD0.xy * _TextureMaskAlpha_ST.xy + _TextureMaskAlpha_ST.zw;\n   
            u_xlat16_1.x = texture(_TextureMaskAlpha, u_xlat1.xy).x;\n    u_xlatb3
            = vec4(0.0, 0.0, 0.0, 0.0)!=vec4(_UseTextureMaskAlpha);\n    u_xlat1.x
            = (u_xlatb3) ? u_xlat16_1.x : 1.0;\n    u_xlat0 = u_xlat0 * u_xlat1.xxxx;\n   
            u_xlat0.xyz = u_xlat0.xyz * vec3(vec3(_EmissiveMultiply, _EmissiveMultiply,
            _EmissiveMultiply));\n    u_xlat1.w = dot(u_xlat0.ww, vec2(_OpacityMultiply));\n   
            u_xlat1.w = clamp(u_xlat1.w, 0.0, 1.0);\n    u_xlat1.xyz = u_xlat0.xyz
            * vec3(4.5947938, 4.5947938, 4.5947938);\n    SV_Target0 = u_xlat1;\n   
            return;\n}\n\n"
