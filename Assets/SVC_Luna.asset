            = _TintColor.xyz * vec3(vec3(_ColorMultiplier, _ColorMultiplier, _ColorMultiplier));\n   
            u_xlat1.xyz = u_xlat16_1.xyz * u_xlat2.xyz;\n    u_xlat0.xyz = u_xlat0.xyz
            * u_xlat1.xyz;\n    u_xlat0.xyz = u_xlat0.xyz + u_xlat0.xyz;\n    SV_Target0.xyz
            = vec3(u_xlat9) * u_xlat0.xyz;\n    SV_Target0.w = 1.0;\n    return;\n}\n\n"
